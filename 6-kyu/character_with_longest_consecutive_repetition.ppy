def longest_repetition(chars):
    if not chars:
        return ('', 0)

    best_char = chars[0]
    best_len = 1
    cur_char = chars[0]
    cur_len = 1

    for ch in chars[1:]:
        if ch == cur_char:
            cur_len += 1
        else:
            cur_char = ch
            cur_len = 1

        if cur_len > best_len:
            best_len = cur_len
            best_char = cur_char

    return (best_char, best_len)